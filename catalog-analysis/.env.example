# Copy to .env in this same directory (catalog-analysis/.env):
#   cp .env.example .env
#
# npm run analyze loads this file automatically.

# Required — Anthropic API key for all LLM and vision stages
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-4-20250514 if unset
ANTHROPIC_MODEL=claude-sonnet-4-6
