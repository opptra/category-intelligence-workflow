# Copy to .env in this same directory (catalog-analysis/.env):
#   cp .env.example .env
#
# npm run analyze loads this file automatically.

# Provider: openrouter (default) or anthropic
LLM_PROVIDER=openrouter

# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=scrapper-agent-workflow

# Anthropic (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Marketplace used for backend-keyword byte budgets (IN=200, US/EU=249, JP=500)
MARKETPLACE=IN
