# Copy to .env in this same directory (catalog-analysis/.env):
#   cp .env.example .env
#
# npm start (orchestrator) and npm run analyze load this file automatically.

# Required — OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — OpenRouter model id (provider/model). Must support tools + vision.
# Examples: anthropic/claude-sonnet-4, anthropic/claude-sonnet-4.6, openai/gpt-4o
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional — override only if you proxy OpenRouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api
