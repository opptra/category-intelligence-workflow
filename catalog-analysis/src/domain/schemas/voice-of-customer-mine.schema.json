{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["signals"],
  "properties": {
    "signals": {
      "type": "array",
      "minItems": 10,
      "maxItems": 60,
      "description": "Short buyer phrases with approximate mention_count from the sample; include complaints and objections, not only praise",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phrase", "sentiment", "relevance", "mention_count"],
        "properties": {
          "phrase": { "type": "string" },
          "sentiment": {
            "type": "string",
            "enum": ["praise", "complaint", "objection", "neutral"]
          },
          "relevance": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "mention_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional grouping of recurring themes",
      "properties": {
        "praise": {
          "type": "array",
          "items": { "type": "string" }
        },
        "complaints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "objections": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
