{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "summary", "category_lexicon", "voice_of_customer", "topics"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "category", "marketplace", "generated_at", "competitor_count"],
      "properties": {
        "schema_version": { "type": "string", "const": "2.1" },
        "category": { "type": "string" },
        "marketplace": { "type": "string" },
        "generated_at": { "type": "string" },
        "competitor_count": { "type": "integer", "minimum": 1 },
        "model": { "type": "string" }
      }
    },
    "summary": { "type": "string" },
    "category_lexicon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "terms"],
      "properties": {
        "observations": { "type": "string" },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "relevance"],
            "properties": {
              "term": { "type": "string" },
              "relevance": {
                "type": "string",
                "enum": ["high", "medium"]
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "voice_of_customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "signals"],
      "properties": {
        "observations": { "type": "string" },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phrase", "sentiment", "relevance", "mention_count"],
            "properties": {
              "phrase": { "type": "string" },
              "sentiment": {
                "type": "string",
                "enum": ["praise", "complaint", "objection", "neutral"]
              },
              "relevance": {
                "type": "string",
                "enum": ["high", "medium"]
              },
              "mention_count": { "type": "integer", "minimum": 1 }
            }
          },
          "minItems": 1
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "observations", "actions"],
        "properties": {
          "name": { "type": "string" },
          "observations": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      },
      "minItems": 9
    }
  }
}
