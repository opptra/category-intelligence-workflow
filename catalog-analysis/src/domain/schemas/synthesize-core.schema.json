{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "category_lexicon", "voice_of_customer"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Primary focus: how top sellers win in this category. Briefly note catalog-level shortfalls vs that bar when relevant."
    },
    "category_lexicon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "terms"],
      "properties": {
        "observations": {
          "type": "string",
          "description": "How leaders distribute seller vocabulary across title, bullets, A+, specs"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "relevance"],
            "properties": {
              "term": { "type": "string" },
              "relevance": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            }
          }
        }
      }
    },
    "voice_of_customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "signals"],
      "properties": {
        "observations": {
          "type": "string",
          "description": "Unified category buyer-language summary. Research may include separate leader/our review mines — merge into one narrative; do not label buckets in the output."
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phrase", "sentiment", "relevance", "mention_count"],
            "properties": {
              "phrase": { "type": "string" },
              "sentiment": {
                "type": "string",
                "enum": ["praise", "complaint", "objection", "neutral"]
              },
              "relevance": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "mention_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
