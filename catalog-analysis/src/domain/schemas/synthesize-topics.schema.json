{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "observations", "actions"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "title",
              "bullets",
              "keywords",
              "gallery_images",
              "aplus",
              "specs",
              "pricing",
              "reviews_and_trust",
              "consistency_and_hygiene"
            ]
          },
          "observations": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
