{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "observations", "actions"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "title",
              "item_highlights",
              "bullets",
              "keywords",
              "gallery_images",
              "aplus",
              "specs",
              "pricing",
              "reviews_and_trust",
              "consistency_and_hygiene"
            ]
          },
          "observations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500,
            "description": "Research findings for this topic in prose"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "description": "Category-wide playbook steps; may mention aggregated catalog gaps, never individual SKUs/ASINs",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      }
    }
  }
}
