{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cells", "present_roles", "quality_notes"],
  "properties": {
    "hero_conventions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell", "role"],
        "properties": {
          "cell": { "type": "integer", "minimum": 1 },
          "role": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "present_roles": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "missing_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quality_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
