{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "item_highlights", "keyword_map", "bullet_topics", "bullet_framing_pattern"],
  "properties": {
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "required_tokens", "mobile_first_75_chars"],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "Reusable title pattern that fits Amazon's 75-character title limit"
        },
        "required_tokens": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Tokens that almost always appear in winning titles"
        },
        "mobile_first_75_chars": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Example titles already within 75 characters"
        }
      }
    },
    "item_highlights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template"],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "Pattern for the 125-character searchable Item Highlights field under the title"
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Example highlight lines within 125 characters"
        }
      }
    },
    "keyword_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "long_tail", "vernacular", "occasion"],
      "properties": {
        "head": { "type": "array", "items": { "type": "string" } },
        "long_tail": { "type": "array", "items": { "type": "string" } },
        "vernacular": { "type": "array", "items": { "type": "string" } },
        "occasion": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bullet_topics": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "bullet_framing_pattern": { "type": "string" }
  }
}
